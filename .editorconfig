# Stop searching for .editorconfig files in parent directories
root = true

# All files - Core EditorConfig rules (Supported natively by both IDEs)
[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# Specific rules (.NET Roslyn Compiler Analyzers)
[*.cs]

#### Code Style Rules ####

# Require var when type is apparent, otherwise prefer explicit types
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Use language keywords instead of framework type names (e.g., int vs Int32)
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Code Block Preferences
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = false:none
csharp_style_expression_bodied_constructors = false:none

# Namespace preferences (Modern file-scoped namespaces)
csharp_style_namespace_declarations = file_scoped:suggestion

#### Formatting / Layout Rules ####

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

#### Naming Conventions ####

# Interfaces must start with an I
dotnet_naming_rule.interface_should_be_begun_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begun_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_begun_with_i.style = pascal_case_with_i_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case_with_i_style.required_prefix = I
dotnet_naming_style.pascal_case_with_i_style.capitalization = pascal_case
